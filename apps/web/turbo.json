{
  "$schema": "https://turborepo.org/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "env": [
        "ASSET_PREFIX_URL",
        "BASE_PATH",
        "BETTER_AUTH_URL",
        "E2E_TESTING",
        "FORMS_LOCAL_START",
        "NEXTAUTH_URL",
        "NODE_ENV",
        "WEBAPP_URL"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.test.*",
        "!**/*.spec.*",
        "!**/__tests__/**",
        "!**/vitest.config.*",
        "!**/vitest.integration.config.*",
        "!**/playwright/**",
        "!integration/**"
      ],
      "passThroughEnv": [
        "AUDIT_LOG_ENABLED",
        "AUDIT_LOG_GET_USER_IP",
        "AUTH_SKIP_INVITE_FOR_SSO",
        "AUTH_SSO_DEFAULT_ORGANIZATION_ID",
        "AUTH_SSO_DEFAULT_ORGANIZATION_ROLE",
        "AUTH_SSO_DEFAULT_TEAM_ID",
        "AUTHZED_CONSISTENCY",
        "AUTHZED_ENABLED",
        "AUTHZED_ENDPOINT",
        "AUTHZED_INSECURE",
        "AUTHZED_SYSTEM_KEY",
        "AUTHZED_TOKEN",
        "BETTER_AUTH_SECRET",
        "BULLMQ_EXTERNAL_WORKER_ENABLED",
        "BULLMQ_WORKER_CONCURRENCY",
        "BULLMQ_WORKER_COUNT",
        "BULLMQ_WORKER_ENABLED",
        "CRON_SECRET",
        "DANGEROUSLY_ALLOW_WEBHOOK_INTERNAL_URLS",
        "DATABASE_URL",
        "DEBUG",
        "DEBUG_SHOW_RESET_LINK",
        "EMAIL_AUTH_DISABLED",
        "EMAIL_VERIFICATION_DISABLED",
        "ENCRYPTION_KEY",
        "ENVIRONMENT",
        "HEROKU_APP_NAME",
        "HTTP_PROXY",
        "HTTPS_PROXY",
        "IMPRINT_ADDRESS",
        "IMPRINT_URL",
        "INVITE_DISABLED",
        "INVITE_RATE_LIMIT_PER_24_HOURS",
        "LOG_LEVEL",
        "MAIL_FROM",
        "MAIL_FROM_NAME",
        "MCP_DCR_ALLOWED_REDIRECT_URIS",
        "MCP_OAUTH_JWKS_URL",
        "NEXT_PHASE",
        "NEXT_RUNTIME",
        "NEXTAUTH_SECRET",
        "npm_package_version",
        "OTEL_EXPORTER_OTLP_ENDPOINT",
        "OTEL_EXPORTER_OTLP_HEADERS",
        "OTEL_EXPORTER_OTLP_PROTOCOL",
        "OTEL_LOGS_ENABLED",
        "OTEL_RESOURCE_ATTRIBUTES",
        "OTEL_SERVICE_NAME",
        "OTEL_TRACES_SAMPLER",
        "OTEL_TRACES_SAMPLER_ARG",
        "PASSWORD_RESET_DISABLED",
        "PASSWORD_RESET_TOKEN_LIFETIME_MINUTES",
        "PLAYWRIGHT_CI",
        "PLAYWRIGHT_SERVICE_URL",
        "PRIVACY_URL",
        "PROMETHEUS_ENABLED",
        "PROMETHEUS_EXPORTER_PORT",
        "PUBLIC_URL",
        "RATE_LIMITING_DISABLED",
        "RECAPTCHA_SITE_KEY",
        "REDIS_URL",
        "SESSION_MAX_AGE",
        "SIGNUP_DOMAIN_CHECK_ON_INVITES",
        "SINGLE_USE_LEGACY_UNSIGNED_UNTIL",
        "STRAPI_API_KEY",
        "SURVEY_SCHEDULING_LOCAL_HOUR",
        "SURVEY_SCHEDULING_LOCAL_MINUTE",
        "SURVEY_SCHEDULING_TIME_ZONE",
        "SURVEY_VISIBILITY_FORCE_DISABLED",
        "FORMS_UPGRADE_MODE",
        "SURVEY_WORKSPACE_LIMIT",
        "SURVEYS_PACKAGE_BUILD",
        "SURVEYS_PACKAGE_MODE",
        "TERMS_URL",
        "TRUSTED_PROXY_HOP_COUNT",
        "USER_MANAGEMENT_MINIMUM_ROLE",
        "VERSION",
        "WEBHOOK_DELIVERY_TIMEOUT_MS"

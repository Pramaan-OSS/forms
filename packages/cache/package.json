{
  "name": "@forms/cache",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "homepage": "/",
  "description": "Unified Redis cache for Forms",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "/"
  },
  "keywords": [
    "Forms",
    "cache",
    "redis",
    "caching"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "clean": "rimraf .turbo node_modules coverage dist",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:report": "eslint . --format json --output-file ../../lint-results/cache.json",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "go": "vite build --watch --mode dev"
  },
  "author": "Forms <hola@forms.com>",
  "dependencies": {
    "@forms/logger": "workspace:*",
    "redis": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@forms/config-eslint": "workspace:*",
    "@forms/config-typescript": "workspace:*",
    "@forms/vite-plugins": "workspace:*",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:"
  }
}

{
  "name": "@forms/js-core",
  "private": true,
  "type": "module",
  "license": "MIT",
  "version": "1.0.0",
  "description": "Js core for Forms that contains the logic for executing the @forms/js library and is loaded asynchronously over the Forms API.",
  "homepage": "/",
  "repository": {
    "type": "git",
    "url": "/"
  },
  "keywords": [
    "Forms",
    "surveys",
    "experience management"
  ],
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.umd.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.umd.cjs"
    }
  },
  "scripts": {
    "dev": "vite build --watch --mode dev",
    "build": "vite build",
    "build:dev": "vite build --mode dev",
    "go": "vite build --watch --mode dev",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "clean": "rimraf .turbo node_modules dist coverage",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "author": "Forms <hola@forms.com>",
  "devDependencies": {
    "@forms/config-eslint": "workspace:*",
    "@forms/config-typescript": "workspace:*",
    "@forms/vite-plugins": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:"
  }
}

# Required: paste your Pramaan key, then run ./start (Docker is the only prerequisite).
PRAMAAN_API_KEY=

# Optional. Leave commented until needed. All other settings and secrets are generated.
# PRAMAAN_BASE_URL=
# PRAMAAN_FAKE=                 # 1 enables offline test replies; no requests leave the app.
# PRAMAAN_SOCIAL_SIGN_IN=       # Comma-separated keys; see docs/README.md.
# PRAMAAN_ENTERPRISE_SIGN_IN=   # 1 enables configured enterprise sign-in.
# PRAMAAN_BOT_CHECK_WIDGET=    # Requires your own connected challenge-widget account.
# RECAPTCHA_SITE_KEY=         # Your response challenge widget's public site key.
# TURNSTILE_SITE_KEY=         # Your sign-up challenge widget's public site key.
# FORMS_STORAGE_DRIVER=       # local (default) or pramaan (optional remote storage).
# FORMS_STORAGE_BUCKET=       # Remote storage bucket, default forms.
# FORMS_UPLOAD_DIR=           # Local upload directory; the bundled container sets it.
# MAIL_FROM=                  # Optional owner reply address only; default From uses sender-domain.ts in apps/web/modules/email/lib.
# MAIL_FROM_NAME=             # Sender display name, default Forms.
# APP_URL=                    # Optional public address; also sets app/session origins.
# WEBAPP_URL=                 # Default http://localhost:3036.
# BETTER_AUTH_URL=            # Defaults to WEBAPP_URL.
# APP_PORT=                   # Default 3036.
# POSTGRES_PORT=              # Default 55436; never uses the standard host port 5432.
# REDIS_PORT=                 # Default 56336; change for a separate local install.
# PERMISSIONS_PORT=           # Default 55056; change for a separate local install.
# EMAIL_VERIFICATION_DISABLED= # 1 for local testing only; test mode sets it automatically.
# OTEL_EXPORTER_OTLP_ENDPOINT= # Optional collector you operate; export is off by default.

{
  "name": "forms",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "agents:update": "npx @next/codemod@canary agents-md --output AGENTS.md",
    "clean:all": "turbo run clean && rimraf node_modules pnpm-lock.yaml .turbo coverage out",
    "clean": "turbo run clean && rimraf node_modules .turbo coverage out",
    "clean:cache": "rimraf .turbo/cache apps/web/.next",
    "build": "turbo run build",
    "build:dev": "turbo run build:dev",
    "db:migrate:dev": "turbo run db:migrate:dev",
    "db:migrate:deploy": "turbo run db:migrate:deploy",
    "db:start": "turbo run db:start",
    "db:push": "turbo run db:push",
    "db:seed": "turbo run db:seed",
    "db:seed:clear": "turbo run db:seed -- -- --clear",
    "db:up": "./start",
    "db:down": "./stop",
    "authzed:backfill": "dotenv -e .env -v NODE_OPTIONS=--conditions=react-server -v LOG_LEVEL=fatal -- tsx --tsconfig apps/web/tsconfig.json ./apps/web/scripts/authzed-backfill.ts",
    "authzed:outbox": "dotenv -e .env -v NODE_OPTIONS=--conditions=react-server -v LOG_LEVEL=fatal -- tsx --tsconfig apps/web/tsconfig.json ./apps/web/scripts/docker/authzed-cli.ts outbox",
    "authzed:perf": "dotenv -e .env -v NODE_OPTIONS=--conditions=react-server -v LOG_LEVEL=fatal -- tsx --tsconfig apps/web/tsconfig.json ./apps/web/scripts/authzed-perf.ts",
    "qsf:eval": "dotenv -e .env -v NODE_OPTIONS=--conditions=react-server -v LOG_LEVEL=fatal -- tsx ./apps/web/scripts/run-esm-script.mts ./apps/web/scripts/qsf-import-eval.ts",
    "authzed:health": "dotenv -e .env -v NODE_OPTIONS=--conditions=react-server -v LOG_LEVEL=fatal -- tsx --tsconfig apps/web/tsconfig.json ./apps/web/scripts/authzed-health.ts",
    "authzed:schema": "dotenv -e .env -v NODE_OPTIONS=--conditions=react-server -v LOG_LEVEL=fatal -- tsx --tsconfig apps/web/tsconfig.json ./apps/web/scripts/authzed-schema.ts",
    "authzed:smoke": "bash docker/authzed-smoke.sh",
    "authzed:validate": "bash authzed/validate.sh",
    "authzed:upgrade": "dotenv -e .env -v NODE_OPTIONS=--conditions=react-server -v LOG_LEVEL=fatal -- tsx --tsconfig apps/web/tsconfig.json ./apps/web/scripts/authzed-upgrade.ts",
    "go": "./start",
    "dev": "turbo run dev --parallel",
    "pre-commit": "lint-staged",
    "start": "./start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate": "turbo run generate",
    "catalog:check": "node scripts/check-catalog.mjs",
    "lint": "turbo run lint && pnpm api:v3:lint && pnpm api:v3:check && pnpm api:v3:schemas:check && pnpm catalog:check",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test test:root --no-cache",
    "test:root": "vitest run --config vitest.root.config.mts",
    "test:coverage": "turbo run test:coverage --no-cache",
    "test:e2e": "playwright test",
    "test-e2e:azure": "pnpm test:e2e -c playwright.service.config.ts --workers=10",
    "prepare": "husky",
    "storybook": "turbo run storybook",
    "fb-migrate-dev": "pnpm --filter @forms/database create-migration && pnpm --filter @forms/database generate",
    "scan-translations": "pnpm --filter @forms/i18n-utils scan-translations",
    "i18n:validate": "pnpm scan-translations",
    "api:v3:bundle": "node docs/api-v3-reference/scripts/bundle.mjs",
    "api:v3:lint": "node docs/api-v3-reference/scripts/bundle.mjs --lint",
    "api:v3:check": "node docs/api-v3-reference/scripts/bundle.mjs --check",
    "api:v3:schemas": "pnpm --filter @forms/api-v3-schemas schemas:generate",
    "api:v3:schemas:check": "pnpm --filter @forms/api-v3-schemas schemas:check",
    "api:v3:sync": "pnpm api:v3:bundle && pnpm api:v3:schemas"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.3",
    "@azure/playwright": "1.1.5",
    "@forms/config-eslint": "workspace:*",
    "@playwright/test": "catalog:",
    "@redocly/cli": "1.34.17",
    "@trivago/prettier-plugin-sort-imports": "catalog:",
    "dotenv": "catalog:",
    "eslint": "9.39.5",
    "husky": "9.1.7",
    "js-yaml": "catalog:",
    "lint-staged": "16.4.0",
    "prettier": "catalog:",
    "prettier-plugin-sort-json": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "rimraf": "catalog:",
    "tsx": "catalog:",
    "turbo": "2.9.14",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "packageManager": "pnpm@11.7.0"
}
